{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Next.js dev",
      "type": "npm",
      "script": "dev",
      "args": ["--", "-p", "3000"],
      "options": {
        "env": {
          "PATH": "/Users/giandomenico/.nvm/versions/node/v22.17.0/bin:${env:PATH}",
          "DEBUG_BOT": "true"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*next dev.*",
          "endsPattern": ".*Local:.*"
        }
      }
    }
  ]
}
