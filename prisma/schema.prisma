generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int      @id @default(autoincrement())
  telegramId          String   @unique
  age                 Int?
  height              Int?
  weight              Float?
  goal                String?
  onboardingCompleted Boolean  @default(false)
  step                String?
  createdAt           DateTime @default(now())
  username            String?
  firstName           String?
  meals               Meal[]
}

model Meal {
  id        Int      @id @default(autoincrement())
  name      String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  calories  Float?
  protein   Float?
  carbs     Float?
  fat       Float?
}
