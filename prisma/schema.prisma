generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int      @id @default(autoincrement())
  telegramId          String   @unique
  username            String?
  firstName           String?
  age                 Int?
  height              Int?
  weight              Float?
  goal                String?
  onboardingCompleted Boolean  @default(false)
  step                String?
  createdAt           DateTime @default(now())
}
